# Local-only regulatory-framing review skill (Claude Code + Codex).
# Reviews public *.md edits against the Russian regulatory regime around
# VPN/circumvention advertising. Wired up via the PostToolUse hook in
# .claude/settings.json. Local to each contributor's machine; never
# committed.
.claude/skills/legal-check/
.codex/agents/legal-check.toml

# Test artifact: adaptive tuning state written by soak tests with random ephemeral ports
native/rust/crates/ripdpi-monitor/adaptive-tuning-v1.json
native/rust/crates/ripdpi-bench/adaptive-tuning-v1.json

# Appium smoke artifacts
appium/appium-report.html
appium/screenshots/

# Detekt baselines are forbidden — violations must be fixed in code
detekt-baseline.xml

# compose-ai-tools render output (renderAllPreviews task) — throwaway PNGs
# for AI agents and human reviewers. Never goldens; see
# .claude/rules/compose-preview.md and .claude/rules/golden-bless-discipline.md.
**/build/compose-previews/

# gomobile-built libXray Android artifacts (AAR + per-ABI .so + manifest).
# Produced locally/CI by scripts/native/build-libxray.sh; never committed —
# verified by scripts/native/verify-libxray-artifacts.sh. See
# docs/native/libxray-packaging.md and gradle/libs.versions.toml pins.
native/xray/artifacts/

# Local design-review captures and reports (screenshots, PDFs, helper scripts).
# Throwaway agent/review artifacts — never committed.
design-review/

# Advisor implementation plans (improve skill output) — local working artifacts
/plans/

# Compiled-in server config for the "simple" flavor. Holds the emit-bundle
# output (per-client UUIDs/passwords, AmneziaWG private key) and must never be
# committed — it ships inside the simple APK but stays out of source control.
# Consumed by the simple-flavor first-launch seeder (ConfigSeeder); when the
# file is absent the seeder no-ops, so other flavors/CI build fine without it.
app/src/simple/assets/embedded-relay-bundle.json
