{
  "matrix_version": 1,
  "patterns": [
    {
      "id": "rst-after-sni-match",
      "config": {
        "sni_blocklist": ["blocked.example", "tspu-target.example"]
      }
    },
    {
      "id": "quic-initial-drop",
      "config": {
        "alpn_blocklist": ["h3"],
        "sni_blocklist": ["blocked.example"]
      }
    },
    {
      "id": "sni-replace",
      "config": {
        "sni_blocklist": ["blocked.example"],
        "replacement_sni": "sinkhole.local"
      }
    },
    {
      "id": "ip-blackhole-after-n-bytes",
      "config": {
        "threshold_bytes": 1000,
        "target_dst_ports": [443]
      }
    },
    {
      "id": "mtu-clamp",
      "config": {
        "mtu_payload_bytes": 200
      }
    }
  ],
  "combinations": [
    {
      "id": "tcp-sni-and-mtu",
      "description": "Per-packet TCP TSPU: RST on SNI, ClientHello rewrite, and oversize-packet drop are all on at once.",
      "patterns": ["rst-after-sni-match", "sni-replace", "mtu-clamp"]
    },
    {
      "id": "quic-strict",
      "description": "QUIC-side TSPU pessimistic: Initial drop plus IP blackhole after 1000 bytes.",
      "patterns": ["quic-initial-drop", "ip-blackhole-after-n-bytes"]
    },
    {
      "id": "all-tcp-and-blackhole",
      "description": "Defense-in-depth on the TCP path: every TCP-side pattern plus the byte-budget blackhole.",
      "patterns": ["rst-after-sni-match", "sni-replace", "ip-blackhole-after-n-bytes", "mtu-clamp"]
    },
    {
      "id": "all-five",
      "description": "Worst-case adversary: every v1.1 pattern active simultaneously.",
      "patterns": [
        "rst-after-sni-match",
        "quic-initial-drop",
        "sni-replace",
        "ip-blackhole-after-n-bytes",
        "mtu-clamp"
      ]
    }
  ],
  "desync_modes": [
    "split_offset_3_chlo",
    "tlsrandrec_profile_a",
    "fakettl_2_then_real",
    "quic_initial_with_blocked_sni",
    "quic_initial_with_fake_decoy",
    "large_tls_record_single_packet",
    "long_lived_flow_post_blackhole"
  ]
}
