    <string name="permissions_vpn_title">VPN permission</string>
    <string name="permissions_vpn_body">Android will ask to create a local VPN. This routes traffic through the app on your device — nothing is sent externally.</string>
    <string name="permissions_vpn_continue">Continue</string>
    <string name="permissions_vpn_not_now">Not now</string>
    <string name="permissions_vpn_error_title">Permission still required</string>
    <string name="permissions_vpn_error_body">Grant Android VPN permission to keep RIPDPI running locally on this device.</string>
    <string name="permissions_notifications_title">Allow status notifications</string>
    <string name="permissions_notifications_denied">Allow notifications to show RIPDPI status and service alerts while the local VPN or proxy is running.</string>
    <string name="permissions_notifications_open_settings">Notification permission is still blocked. Open app settings and allow notifications for RIPDPI.</string>
    <string name="permissions_battery_title">Battery optimization</string>
    <string name="permissions_battery_body">Allow RIPDPI to ignore Android battery optimization so Doze is less likely to interrupt the local VPN or proxy in the background.</string>
    <string name="permissions_background_activity_title">Background activity</string>
    <string name="permissions_background_activity_body">Some devices add extra background limits beyond Android battery optimization. If RIPDPI stops in the background, review the app battery or background usage settings.</string>
    <string name="permissions_background_activity_body_xiaomi">Xiaomi/MIUI devices may block RIPDPI from running in the background. Go to Settings &gt; Apps &gt; Manage apps &gt; RIPDPI, set Battery saver to No restrictions and enable Autostart.</string>
    <string name="permissions_background_activity_body_huawei">Huawei devices may stop RIPDPI in the background. Go to Settings &gt; Battery &gt; App launch, find RIPDPI, disable automatic management, and enable Auto-launch, Secondary launch, and Run in background.</string>
    <string name="permissions_background_activity_body_oneplus">OnePlus devices may aggressively stop background apps. Go to Settings &gt; Battery &gt; Battery optimization, find RIPDPI and select Don\'t optimize. Also disable Deep Optimization and Sleep Standby Optimization if available.</string>
