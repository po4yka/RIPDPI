    <string name="notice_host_packs_refreshed_title">Host packs refreshed</string>
    <string name="notice_host_packs_refreshed_message">RIPDPI downloaded geosite.dat, verified its SHA-256 checksum, and updated the on-device curated host packs.</string>
    <string name="notice_host_pack_verification_failed_title">Host pack verification failed</string>
    <string name="notice_host_pack_verification_failed_message">The downloaded geosite.dat checksum did not match the published SHA-256 digest. RIPDPI kept the current curated host packs.</string>
    <string name="notice_host_pack_refresh_failed_title">Host pack refresh failed</string>
    <string name="notice_host_pack_refresh_failed_message">RIPDPI verified the download, but the remote geosite.dat did not produce a complete YouTube, Telegram, and Discord catalog. The current packs remain in use.</string>
    <string name="notice_host_pack_download_failed_title">Couldn\'t refresh host packs</string>
    <string name="notice_host_pack_download_failed_message">RIPDPI could not download the latest geosite.dat or checksum file. The current curated host packs remain in use.</string>
    <string name="notice_strategy_packs_refreshed_title">Strategy packs refreshed</string>
    <string name="notice_strategy_packs_refreshed_message">RIPDPI downloaded, verified, and activated the latest strategy-pack catalog allowed for this device.</string>
    <string name="notice_strategy_pack_refresh_failed_title">Couldn\'t refresh strategy packs</string>
    <string name="notice_strategy_pack_refresh_failed_message">RIPDPI could not refresh the latest strategy-pack catalog. The current strategy snapshot remains active.</string>
    <string name="notice_learned_hosts_clear_failed_title">Couldn\'t clear learned hosts</string>
    <string name="notice_learned_hosts_clear_failed_message">RIPDPI could not delete the stored host learning file on this device.</string>
    <string name="notice_learned_hosts_cleared_next_start_title">Learned hosts cleared for next start</string>
    <string name="notice_learned_hosts_cleared_next_start_message">The stored host learning file was removed. The running proxy keeps its in-memory routes until RIPDPI restarts.</string>
    <string name="notice_learned_hosts_cleared_title">Learned hosts cleared</string>
    <string name="notice_learned_hosts_cleared_message">Stored host learning was removed and the next RIPDPI start will rebuild it from scratch.</string>
    <string name="notice_remembered_networks_cleared_title">Remembered networks cleared</string>
    <string name="notice_remembered_networks_cleared_message">RIPDPI removed all stored per-network routing policies. Current settings remain unchanged.</string>
    <string name="notice_fake_tls_reset_next_start_title">Fake TLS profile reset for next start</string>
    <string name="notice_fake_tls_reset_next_start_message">The profile is back to the default fake ClientHello. Restart RIPDPI to apply it to the active session.</string>
    <string name="notice_fake_tls_reset_title">Fake TLS profile reset</string>
    <string name="notice_fake_tls_reset_message">RIPDPI will use the default fake ClientHello, fixed SNI, and input-sized payload on the next start.</string>
    <string name="notice_adaptive_ttl_reset_next_start_title">Adaptive fake TTL reset for next start</string>
    <string name="notice_adaptive_ttl_reset_next_start_message">RIPDPI will go back to a fixed fake TTL for the active group after the next restart or reconnect.</string>
    <string name="notice_adaptive_ttl_reset_title">Adaptive fake TTL reset</string>
    <string name="notice_adaptive_ttl_reset_message">RIPDPI will stop learning fake TTL values and use the fixed fake TTL on the next start.</string>
    <string name="notice_fake_payload_reset_next_start_title">Fake payload presets reset for next start</string>
    <string name="notice_fake_payload_reset_next_start_message">HTTP, TLS, and UDP fake payloads are back to compatibility defaults. Restart RIPDPI to apply them to the active session.</string>
    <string name="notice_fake_payload_reset_title">Fake payload presets reset</string>
    <string name="notice_fake_payload_reset_message">RIPDPI will use the compatibility fake payload defaults for HTTP, TLS, and UDP on the next start.</string>
    <string name="notice_http_parser_reset_next_start_title">HTTP parser evasions reset for next start</string>
    <string name="notice_http_parser_reset_next_start_message">HTTP parser tweaks are back to their defaults. Restart RIPDPI to remove the saved parser evasions from the active session.</string>
    <string name="notice_http_parser_reset_title">HTTP parser evasions reset</string>
    <string name="notice_http_parser_reset_message">RIPDPI will stop applying saved HTTP parser tweaks and EOL evasions on the next start.</string>
    <string name="notice_activation_window_reset_next_start_title">Activation window reset for next start</string>
    <string name="notice_activation_window_reset_next_start_message">The active bypass strategy group is back to always-on gating. Restart RIPDPI to remove the saved activation window from the running session.</string>
    <string name="notice_activation_window_reset_title">Activation window reset</string>
    <string name="notice_activation_window_reset_message">RIPDPI will stop gating the active bypass strategy group by round, payload size, or stream-byte position on the next start.</string>
    <string name="notice_telemetry_salt_reset_title">Telemetry salt reset</string>
    <string name="notice_telemetry_salt_reset_message">A new salt will be generated on the next connection. Previously recorded fingerprint hashes can no longer be correlated.</string>
