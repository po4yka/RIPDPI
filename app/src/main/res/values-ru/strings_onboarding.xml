    <string name="onboarding_local_first_body">Всё работает на вашем устройстве.</string>
    <string name="onboarding_setup_finish">Завершить</string>
    <string name="onboarding_setup_mode_title">Выберите режим трафика</string>
    <string name="onboarding_setup_mode_vpn_title">Режим VPN</string>
    <string name="onboarding_setup_mode_vpn_body">Направляет трафик всех приложений через VPN на устройстве. Android сначала запросит разрешение.</string>
    <string name="onboarding_setup_mode_proxy_title">Режим Proxy</string>
    <string name="onboarding_setup_mode_proxy_body">Запускает локальный прокси для приложений и клиентов, поддерживающих ручную настройку прокси.</string>
    <string name="onboarding_setup_dns_system">Системный по умолчанию</string>
    <string name="onboarding_setup_dns_system_body">Использовать DNS-серверы текущей сети без изменений.</string>
    <string name="onboarding_setup_dns_cloudflare_body">Быстрый универсальный DNS-резолвер.</string>
    <string name="onboarding_setup_dns_quad9_body">DNS-резолвер с акцентом на безопасность.</string>
    <string name="onboarding_setup_dns_adguard_body">DNS-резолвер с фильтрацией рекламы и трекеров.</string>
    <string name="onboarding_setup_validate_title">Проверка соединения</string>
