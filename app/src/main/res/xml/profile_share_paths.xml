<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for the AmneziaWG server share. The shared .conf is written to a
    dedicated cache subdirectory and granted read access per share intent; files older
    than a day are removed on the next app start or share.
-->
<paths>
    <cache-path
        name="profile_share"
        path="profile-share/" />
</paths>
