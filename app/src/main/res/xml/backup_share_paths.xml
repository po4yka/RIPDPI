<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for the optional "share backup" follow-up. A backup copied
    into this dedicated cache subdirectory is granted read access per share intent;
    the host cleans old files on the next app start or backup-screen visit after 24 hours.
    The primary export path writes to a user-chosen SAF location and does not use this provider.
-->
<paths>
    <cache-path
        name="backup_share"
        path="backup-share/" />
</paths>
