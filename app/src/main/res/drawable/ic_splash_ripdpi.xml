<?xml version="1.0" encoding="utf-8"?>
<!--
The splash icon: ic_launcher_foreground_ripdpi_clean in colors that follow night mode, with the ghost as its own
shape in the background color instead of a hole in the stone. Keep the paths equal to the launcher foreground.

The entry plays once the window shows. On API 31 and later that is the launch animation, which opens the window
about 400ms after the platform starts the icon animation (measured on an API 35 emulator). Below API 31 the app
starts this drawable itself, on a window that is already open, so the wait is 0ms. The splash_entry_*_millis
integers carry the wait for each API level. Times on API 31 and later:
  400-520  the ground line draws out from the middle
  460-780  the stone rises out of the ground
  700-920  the ghost appears in the stone
  780-900  the ground line fades
Every animated value is held from 0ms, so no part shows its end value early. The total is
splash_icon_animation_millis; the platform limit is 1000ms. The vector is the end pose, so a splash screen with
animations off shows the plain mark.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="1024"
            android:viewportHeight="1024">
            <group
                android:name="logo-shape"
                android:pivotX="512"
                android:pivotY="507"
                android:scaleX="0.70"
                android:scaleY="0.70">
                <!-- The ground: its top edge is the foot of the stone at y 839, 60 past each side of the foot. -->
                <path
                    android:name="ground"
                    android:pathData="M179,847 H849"
                    android:strokeAlpha="0"
                    android:strokeColor="@color/splash_glyph"
                    android:strokeWidth="16" />
                <group android:name="soil">
                    <!-- Only the part of the stone above the ground shows. -->
                    <clip-path android:pathData="M0,0 H1024 V839 H0 Z" />
                    <group android:name="stone">
                        <path
                            android:fillColor="@color/splash_glyph"
                            android:pathData="M500.84 175.215C502.69 174.966 509.195 174.933 511.27 174.955C573.165 175.624 635.07 199.368 678.865 243.372C706.055 270.631 725.335 304.764 734.635 342.124C743.665 378.292 742.055 404.558 742.055 441.17L742.045 519.66V755.425C745.585 755.19 749.48 755.115 753.005 755.21C770.42 755.685 787.99 751.12 787.385 775.48C786.955 792.735 788.46 811.355 786.74 828.595C786.315 832.815 780.285 838.165 776.05 838.01C767.075 838.545 758.105 838.39 749.115 838.385L698.04 838.37L527.285 838.385L350.789 838.405L286.671 838.4C275.623 838.395 264.483 838.275 253.452 838.24C234.251 838.19 238.044 821.385 238.062 807.5L237.929 773.85C237.932 749.375 264.44 755.255 282.451 755.315L282.444 511.87L282.382 439.359C282.268 408.433 281.076 382.178 287.487 351.597C294.509 316.401 310.39 283.577 333.63 256.228C366.783 217.646 411.71 191.043 461.48 180.525C475.636 177.483 486.509 176.339 500.84 175.215Z" />
                        <!-- Pivot: the middle of the ghost. -->
                        <group
                            android:name="ghost"
                            android:pivotX="512"
                            android:pivotY="524">
                            <path
                                android:name="ghost-body"
                                android:fillColor="@color/splash_background"
                                android:pathData="M658.98 672.245C660.08 652.775 656.435 631.385 654.01 611.83L645.025 538.115C640.72 501.385 636.195 464.682 631.455 428.004C628.76 406.676 626.535 385.217 622.415 364.067C620.41 353.772 617.815 345.508 610.945 337.249C601.365 325.73 581.675 324.663 570.68 334.668C567.685 337.547 564.05 342.923 562.96 346.939C557.545 366.893 555.73 389.485 553.645 410.096C551.255 433.749 549.93 448.448 520.495 447.562C507.28 447.165 489.48 450.123 478.667 440.152C472.224 433.788 471.543 421.007 470.578 412.411C469.334 400.749 467.99 389.097 466.546 377.458C463.478 353.121 461.842 326.395 430.087 328.125C421.117 329.94 415.428 332.511 410.111 340.494C405.05 348.092 403.262 356.903 401.497 365.719C398.287 384.804 396.179 404.399 393.76 423.622L380.951 527.73L370.345 615.135C368.802 627.98 365.893 647.8 365.182 660.445C364.881 665.62 365.309 670.81 366.453 675.865C372.766 705.015 396.23 718.395 424.485 713.225C434.193 711.455 444.468 709.49 454.35 710.095C474.881 711.775 494.353 720.74 515.25 719.805C534.905 718.92 553.535 709.87 573.355 709.97C582.83 710.015 592.39 712.44 601.78 713.605C622.07 716.05 639.665 711.385 651.23 693.47C655.81 686.37 657.225 680.3 658.98 672.245Z" />
                            <path
                                android:fillColor="@color/splash_glyph"
                                android:pathData="M585.335 353.615C587.655 353.409 590.01 353.224 592.25 354C594.635 354.827 596.27 356.643 597.305 358.894C601.885 368.843 606.685 423.97 602.56 433.935C600.545 438.805 597.185 441.109 592.47 442.925C565.77 444.355 575.655 414.851 574.86 398.062C575.425 393.635 575.01 388.14 575.74 383.772C577.45 373.469 574.36 358.799 585.335 353.615Z" />
                            <path
                                android:fillColor="@color/splash_glyph"
                                android:pathData="M431.777 353.625C434.044 353.337 436.346 353.134 438.539 353.932C441.195 354.899 443.603 357.461 444.63 360.074C447.576 367.565 449.946 416.296 449.457 425.641C449.301 428.638 448.94 432.256 447.606 434.953C445.437 439.334 441.801 441.434 437.387 443.032C417.784 443.653 418.727 426.859 419.689 412.124C420.768 395.593 421.434 378.687 424.944 362.478C425.809 358.482 428.278 355.595 431.777 353.625Z" />
                        </group>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <!-- The line draws out from its middle, shows while the stone rises, and fades. -->
    <target android:name="ground">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ground_start_millis"
                        android:propertyName="trimPathStart"
                        android:valueFrom="0.5"
                        android:valueTo="0.5"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="120"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="trimPathStart"
                        android:valueFrom="0.5"
                        android:valueTo="0"
                        android:valueType="floatType" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ground_start_millis"
                        android:propertyName="trimPathEnd"
                        android:valueFrom="0.5"
                        android:valueTo="0.5"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="120"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="trimPathEnd"
                        android:valueFrom="0.5"
                        android:valueTo="1"
                        android:valueType="floatType" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ground_fade_millis"
                        android:propertyName="strokeAlpha"
                        android:valueFrom="1"
                        android:valueTo="1"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="120"
                        android:interpolator="@android:interpolator/linear"
                        android:propertyName="strokeAlpha"
                        android:valueFrom="1"
                        android:valueTo="0"
                        android:valueType="floatType" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <!-- 664 is the height of the stone, so it waits below the ground. -->
    <target android:name="stone">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_stone_start_millis"
                        android:propertyName="translateY"
                        android:valueFrom="664"
                        android:valueTo="664"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="320"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="translateY"
                        android:valueFrom="664"
                        android:valueTo="0"
                        android:valueType="floatType" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <!-- The ghost grows to its size while it shows. -->
    <target android:name="ghost">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ghost_start_millis"
                        android:propertyName="scaleX"
                        android:valueFrom="0.8"
                        android:valueTo="0.8"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="220"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="scaleX"
                        android:valueFrom="0.8"
                        android:valueTo="1"
                        android:valueType="floatType" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ghost_start_millis"
                        android:propertyName="scaleY"
                        android:valueFrom="0.8"
                        android:valueTo="0.8"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="220"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="scaleY"
                        android:valueFrom="0.8"
                        android:valueTo="1"
                        android:valueType="floatType" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <!-- The ghost turns from the stone color to the background color: it is not there, then it is. -->
    <target android:name="ghost-body">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:duration="@integer/splash_entry_ghost_start_millis"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="0"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="220"
                        android:interpolator="@interpolator/ripdpi_emphasized_decelerate"
                        android:propertyName="fillAlpha"
                        android:valueFrom="0"
                        android:valueTo="1"
                        android:valueType="floatType" />
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
