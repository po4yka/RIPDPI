    <string name="diagnostics_rkn_headline_not_blocked">sin bloqueo o VPN/proxy activo</string>
    <string name="diagnostics_rkn_note_not_blocked">Todos los sitios de la lista negra cargaron. Estás fuera de la zona bloqueada o tu VPN/proxy enruta el tráfico.</string>
