    <!-- Destructive action confirmation dialogs -->
    <string name="confirm_forget_learned_hosts_title">सीखे गए होस्ट भूल जाएँ?</string>
    <string name="confirm_forget_learned_hosts_body">सभी स्वतः-सीखी गई होस्ट प्रविष्टियाँ हटा दी जाएँगी. इंजन अगले सत्र में शुरू से फिर से सीखना आरंभ करेगा.</string>
    <string name="confirm_forget_learned_hosts_confirm">भूल जाएँ</string>
    <string name="confirm_forget_learned_hosts_dismiss">रद्द करें</string>
    <string name="confirm_clear_remembered_networks_title">याद किए गए नेटवर्क साफ़ करें?</string>
    <string name="confirm_clear_remembered_networks_body">सहेजे गए प्रति-नेटवर्क रणनीति चयन हटा दिए जाएँगे. ऐप पुनः कनेक्ट होने पर हर नेटवर्क का फिर से मूल्यांकन करेगा.</string>
    <string name="confirm_clear_remembered_networks_confirm">साफ़ करें</string>
    <string name="confirm_clear_remembered_networks_dismiss">रद्द करें</string>
    <string name="confirm_rotate_telemetry_salt_title">टेलीमेट्री साल्ट रीसेट करें?</string>
    <string name="confirm_rotate_telemetry_salt_body">पहले रिकॉर्ड किए गए नेटवर्क फ़िंगरप्रिंट हैश अब भविष्य के सत्रों के साथ सहसंबंधित नहीं किए जा सकते.</string>
    <string name="confirm_rotate_telemetry_salt_confirm">रीसेट करें</string>
    <string name="confirm_rotate_telemetry_salt_dismiss">रद्द करें</string>
    <string name="confirm_reset_adaptive_split_title">अनुकूली स्प्लिट रीसेट करें?</string>
    <string name="confirm_reset_adaptive_split_body">स्प्लिट स्थिति मार्कर वापस मैनुअल मोड में चला जाएगा। आपको फिर से कॉन्फ़िगर करना होगा या कोई प्रीसेट चुनना होगा।</string>
    <string name="confirm_reset_adaptive_split_confirm">रीसेट करें</string>
    <string name="confirm_reset_adaptive_split_dismiss">रद्द करें</string>
    <string name="confirm_reset_adaptive_fake_ttl_title">अनुकूली नकली TTL रीसेट करें?</string>
    <string name="confirm_reset_adaptive_fake_ttl_body">TTL प्रोफ़ाइल वापस एक निश्चित मान पर चली जाएगी। रनटाइम लर्निंग डेटा अगले सत्र में हटा दिया जाएगा।</string>
    <string name="confirm_reset_adaptive_fake_ttl_confirm">रीसेट करें</string>
    <string name="confirm_reset_adaptive_fake_ttl_dismiss">रद्द करें</string>
    <string name="confirm_reset_activation_window_title">सक्रियण विंडो रीसेट करें?</string>
    <string name="confirm_reset_activation_window_body">कस्टम राउंड, पेलोड और स्ट्रीम-बाइट फ़िल्टर हटा दिए जाएंगे। सभी पैकेट विंडो प्रतिबंधों के बिना संसाधित होंगे।</string>
    <string name="confirm_reset_activation_window_confirm">रीसेट करें</string>
    <string name="confirm_reset_activation_window_dismiss">रद्द करें</string>
    <string name="confirm_reset_http_parser_evasions_title">HTTP पार्सर इवेज़न रीसेट करें?</string>
    <string name="confirm_reset_http_parser_evasions_body">सभी सुरक्षित और आक्रामक हेडर-म्यूटेशन टॉगल वापस डिफ़ॉल्ट पर चले जाएंगे। लागू करने के लिए सेवा को पुनः आरंभ करना पड़ सकता है।</string>
    <string name="confirm_reset_http_parser_evasions_confirm">रीसेट करें</string>
    <string name="confirm_reset_http_parser_evasions_dismiss">रद्द करें</string>
    <string name="confirm_reset_fake_payload_library_title">नकली पेलोड प्रीसेट रीसेट करें?</string>
    <string name="confirm_reset_fake_payload_library_body">कस्टम TCP और UDP नकली-पेलोड प्रोफ़ाइलें वापस अंतर्निहित डिफ़ॉल्ट पर चली जाएंगी।</string>
    <string name="confirm_reset_fake_payload_library_confirm">रीसेट करें</string>
