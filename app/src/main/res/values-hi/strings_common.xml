    <!-- Settings maintenance notice titles -->
    <string name="notice_host_packs_refreshed_title">होस्ट पैक रीफ़्रेश हुए</string>
    <string name="notice_host_packs_refreshed_message">RIPDPI ने geosite.dat डाउनलोड किया, इसके SHA-256 चेकसम की पुष्टि की, और डिवाइस पर मौजूद चयनित होस्ट पैक अपडेट किए।</string>
    <string name="notice_host_pack_verification_failed_title">होस्ट पैक सत्यापन विफल</string>
    <string name="notice_host_pack_verification_failed_message">डाउनलोड किया गया geosite.dat चेकसम प्रकाशित SHA-256 डाइजेस्ट से मेल नहीं खाया। RIPDPI ने वर्तमान चयनित होस्ट पैक रखे।</string>
    <string name="notice_host_pack_refresh_failed_title">होस्ट पैक रीफ़्रेश विफल</string>
    <string name="notice_host_pack_refresh_failed_message">RIPDPI ने डाउनलोड की पुष्टि की, लेकिन दूरस्थ geosite.dat ने पूरा YouTube, Telegram, और Discord कैटलॉग नहीं बनाया। वर्तमान पैक उपयोग में बने रहते हैं।</string>
    <string name="notice_host_pack_download_failed_title">होस्ट पैक रीफ़्रेश नहीं हो सके</string>
    <string name="notice_host_pack_download_failed_message">RIPDPI नवीनतम geosite.dat या चेकसम फ़ाइल डाउनलोड नहीं कर सका। वर्तमान चयनित होस्ट पैक उपयोग में बने रहते हैं।</string>
    <string name="notice_strategy_packs_refreshed_title">रणनीति पैक रीफ़्रेश हुए</string>
    <string name="notice_strategy_packs_refreshed_message">RIPDPI ने इस डिवाइस के लिए अनुमत नवीनतम रणनीति-पैक कैटलॉग डाउनलोड, सत्यापित, और सक्रिय किया।</string>
    <string name="notice_strategy_pack_refresh_failed_title">रणनीति पैक रीफ़्रेश नहीं हो सके</string>
    <string name="notice_strategy_pack_refresh_failed_message">RIPDPI नवीनतम रणनीति-पैक कैटलॉग रीफ़्रेश नहीं कर सका। वर्तमान रणनीति स्नैपशॉट सक्रिय बना रहता है।</string>
    <string name="notice_learned_hosts_clear_failed_title">सीखे गए होस्ट साफ़ नहीं हो सके</string>
    <string name="notice_learned_hosts_clear_failed_message">RIPDPI इस डिवाइस पर संग्रहीत होस्ट लर्निंग फ़ाइल नहीं हटा सका।</string>
    <string name="notice_learned_hosts_cleared_next_start_title">अगली शुरुआत के लिए सीखे गए होस्ट साफ़ किए गए</string>
    <string name="notice_learned_hosts_cleared_next_start_message">संग्रहीत होस्ट लर्निंग फ़ाइल हटा दी गई। चल रहा प्रॉक्सी RIPDPI के पुनः आरंभ होने तक अपने इन-मेमोरी रूट रखता है।</string>
    <string name="notice_learned_hosts_cleared_title">सीखे गए होस्ट साफ़ किए गए</string>
    <string name="notice_learned_hosts_cleared_message">संग्रहीत होस्ट लर्निंग हटा दी गई और अगली RIPDPI शुरुआत इसे शुरू से बनाएगी।</string>
    <string name="notice_remembered_networks_cleared_title">याद रखे गए नेटवर्क साफ़ किए गए</string>
    <string name="notice_remembered_networks_cleared_message">RIPDPI ने सभी संग्रहीत प्रति-नेटवर्क रूटिंग नीतियाँ हटा दीं। वर्तमान सेटिंग्स अपरिवर्तित रहती हैं।</string>
    <string name="notice_fake_tls_reset_next_start_title">अगली शुरुआत के लिए नकली TLS प्रोफ़ाइल रीसेट</string>
    <string name="notice_fake_tls_reset_next_start_message">प्रोफ़ाइल डिफ़ॉल्ट नकली ClientHello पर वापस आ गई है। सक्रिय सत्र पर इसे लागू करने के लिए RIPDPI पुनः आरंभ करें।</string>
    <string name="notice_fake_tls_reset_title">नकली TLS प्रोफ़ाइल रीसेट</string>
    <string name="notice_fake_tls_reset_message">RIPDPI अगली शुरुआत पर डिफ़ॉल्ट नकली ClientHello, निश्चित SNI, और इनपुट-आकार पेलोड का उपयोग करेगा।</string>
    <string name="notice_adaptive_ttl_reset_next_start_title">अगली शुरुआत के लिए अनुकूली नकली TTL रीसेट</string>
    <string name="notice_adaptive_ttl_reset_next_start_message">अगले पुनः आरंभ या पुनः कनेक्शन के बाद RIPDPI सक्रिय समूह के लिए निश्चित नकली TTL पर वापस आ जाएगा।</string>
    <string name="notice_adaptive_ttl_reset_title">अनुकूली नकली TTL रीसेट</string>
    <string name="notice_adaptive_ttl_reset_message">RIPDPI नकली TTL मान सीखना बंद कर देगा और अगली शुरुआत पर निश्चित नकली TTL का उपयोग करेगा।</string>
    <string name="notice_fake_payload_reset_next_start_title">अगली शुरुआत के लिए नकली पेलोड प्रीसेट रीसेट</string>
    <string name="notice_fake_payload_reset_next_start_message">HTTP, TLS, और UDP नकली पेलोड संगतता डिफ़ॉल्ट पर वापस आ गए हैं। सक्रिय सत्र पर इन्हें लागू करने के लिए RIPDPI पुनः आरंभ करें।</string>
    <string name="notice_fake_payload_reset_title">नकली पेलोड प्रीसेट रीसेट</string>
    <string name="notice_fake_payload_reset_message">RIPDPI अगली शुरुआत पर HTTP, TLS, और UDP के लिए संगतता नकली पेलोड डिफ़ॉल्ट का उपयोग करेगा।</string>
    <string name="notice_http_parser_reset_next_start_title">अगली शुरुआत के लिए HTTP पार्सर चकमे रीसेट</string>
    <string name="notice_http_parser_reset_next_start_message">HTTP पार्सर समायोजन अपने डिफ़ॉल्ट पर वापस आ गए हैं। सक्रिय सत्र से सहेजे गए पार्सर चकमे हटाने के लिए RIPDPI पुनः आरंभ करें।</string>
    <string name="notice_http_parser_reset_title">HTTP पार्सर चकमे रीसेट</string>
    <string name="notice_http_parser_reset_message">RIPDPI अगली शुरुआत पर सहेजे गए HTTP पार्सर समायोजन और EOL चकमे लागू करना बंद कर देगा।</string>
    <string name="notice_activation_window_reset_next_start_title">अगली शुरुआत के लिए सक्रियण विंडो रीसेट</string>
    <string name="notice_activation_window_reset_next_start_message">सक्रिय बायपास रणनीति समूह हमेशा-चालू गेटिंग पर वापस आ गया है। चल रहे सत्र से सहेजी गई सक्रियण विंडो हटाने के लिए RIPDPI पुनः आरंभ करें।</string>
    <string name="notice_activation_window_reset_title">सक्रियण विंडो रीसेट</string>
    <string name="notice_activation_window_reset_message">RIPDPI अगली शुरुआत पर सक्रिय बायपास रणनीति समूह को राउंड, पेलोड आकार, या स्ट्रीम-बाइट स्थिति के अनुसार गेट करना बंद कर देगा।</string>
    <string name="notice_telemetry_salt_reset_title">टेलीमेट्री साल्ट रीसेट</string>
    <string name="notice_telemetry_salt_reset_message">अगले कनेक्शन पर एक नया salt बनाया जाएगा। पहले रिकॉर्ड किए गए fingerprint हैश अब आपस में जोड़े नहीं जा सकते।</string>
