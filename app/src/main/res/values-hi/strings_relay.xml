    <string name="owned_stack_browser_url_placeholder">example.org</string>
    <string name="owned_stack_browser_open_action">RIPDPI ब्राउज़र में खोलें</string>
    <string name="owned_stack_browser_error_title">स्वामित्व-स्टैक अनुरोध विफल</string>
    <string name="owned_stack_browser_backend_http_engine">Android HttpEngine</string>
    <string name="owned_stack_browser_backend_native_fallback">RIPDPI नेटिव फ़ॉलबैक</string>
    <string name="owned_stack_browser_status_value">HTTP %1$d · %2$s</string>
    <string name="owned_stack_browser_tls_profile_value">TLS प्रोफ़ाइल: %1$s</string>
    <string name="owned_stack_browser_trace_confirmed_ech">पुष्ट ECH-सक्षम अथॉरिटी नीति के साथ Android प्लैटफ़ॉर्म पथ का उपयोग किया जा रहा है।</string>
    <string name="owned_stack_browser_trace_opportunistic_platform">Android प्लैटफ़ॉर्म पथ का अवसरानुकूल उपयोग किया जा रहा है; इस होस्ट के लिए कोई पुष्ट ECH-सक्षम अथॉरिटी कैश नहीं है।</string>
    <string name="owned_stack_browser_trace_h2_retry">QUIC-सक्षम प्रयास विफल होने के बाद H2-only प्लैटफ़ॉर्म स्टैक के साथ पुनः प्रयास किया गया।</string>
    <string name="owned_stack_browser_trace_native_ech_missing">इस अथॉरिटी के लिए पुष्ट Android 17 ECH उपलब्ध नहीं है, इसलिए RIPDPI ने नेटिव ओन्ड TLS का उपयोग किया।</string>
    <string name="owned_stack_browser_trace_native_platform_failure">Android प्लैटफ़ॉर्म स्टैक विफल हो गया, इसलिए RIPDPI ने नेटिव ओन्ड TLS का उपयोग किया।</string>
    <string name="owned_stack_browser_trace_native_platform_unavailable">इस डिवाइस पर Android प्लैटफ़ॉर्म स्टैक उपलब्ध नहीं है, इसलिए RIPDPI ने नेटिव ओन्ड TLS का उपयोग किया।</string>
    <string name="owned_stack_browser_empty_body">कोई रिस्पॉन्स बॉडी नहीं।</string>
