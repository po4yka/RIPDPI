    <string name="warp_section_title">Cloudflare WARP</string>
    <string name="warp_profile_id_title">सक्रिय प्रोफ़ाइल</string>
    <string name="warp_profile_id_body">सुरक्षित क्रेडेंशियल और एंडपॉइंट कैश प्रविष्टियों को बाँधने के लिए उपयोग किया गया चयनित गैर-गोपनीय WARP प्रोफ़ाइल संदर्भ।</string>
    <string name="warp_account_kind_title">खाता प्रकार</string>
    <string name="warp_account_kind_body">सक्रिय WARP पहचान का प्रकार। Consumer Free, WARP+, और Zero Trust अलग-अलग एनरोलमेंट पथ उपयोग करते हैं।</string>
    <string name="warp_zero_trust_org_title">Zero Trust संगठन</string>
    <string name="warp_zero_trust_org_body">तब दिखाया जाता है जब सक्रिय प्रोफ़ाइल किसी Zero Trust एनरोलमेंट से संबंधित होती है।</string>
    <string name="warp_setup_state_title">सेटअप स्थिति</string>
    <string name="warp_setup_state_body">सक्रिय WARP प्रोफ़ाइल के लिए वर्तमान एनरोलमेंट/प्रोविज़निंग स्थिति।</string>
    <string name="warp_last_scanner_mode_title">अंतिम स्कैनर मोड</string>
    <string name="warp_last_scanner_mode_body">वर्तमान एंडपॉइंट चुनाव सबसे हाल में कैसे प्राप्त हुआ।</string>
    <string name="warp_enabled_title">WARP रनटाइम सक्षम करें</string>
    <string name="warp_enabled_body">एक अलग स्थानीय WARP अपस्ट्रीम शुरू करें और RIPDPI को चुने गए ट्रैफ़िक को उसमें चेन करने दें।</string>
    <string name="warp_route_mode_title">WARP रूटिंग मोड</string>
    <string name="warp_route_mode_body">Rules मोड केवल सूचीबद्ध होस्ट को WARP के ज़रिए रूट करता है। Off उपयोगकर्ता ट्रैफ़िक के लिए WARP निष्क्रिय रखता है।</string>
    <string name="warp_route_hosts_title">WARP रूट होस्टलिस्ट</string>
    <string name="warp_route_hosts_body">प्रति पंक्ति एक होस्टनेम। केवल ये गंतव्य स्थानीय WARP SOCKS अपस्ट्रीम को भेजे जाएँगे।</string>
    <string name="warp_builtin_rules_title">अंतर्निहित Cloudflare नियम</string>
    <string name="warp_builtin_rules_body">Cloudflare WARP कंट्रोल-प्लेन डोमेन को WARP में वापस लूप करने के बजाय बूटस्ट्रैप/डायरेक्ट पथ पर रखें।</string>
    <string name="warp_endpoint_mode_title">एंडपॉइंट चयन</string>
    <string name="warp_endpoint_mode_body">Automatic प्रोविज़न किए गए या कैश किए गए एंडपॉइंट का उपयोग करता है। Manual WARP ट्रांसपोर्ट को नीचे दिए मानों पर पिन करता है।</string>
    <string name="warp_manual_host_title">मैनुअल एंडपॉइंट होस्ट</string>
    <string name="warp_manual_host_body">पिन किए गए WARP एंडपॉइंट के लिए उपयोग किया जाने वाला वैकल्पिक होस्टनेम।</string>
    <string name="warp_manual_ipv4_title">मैनुअल एंडपॉइंट IPv4</string>
    <string name="warp_manual_ipv4_body">पिन किए गए एंडपॉइंट के लिए वैकल्पिक IPv4 पता।</string>
    <string name="warp_manual_ipv6_title">मैनुअल एंडपॉइंट IPv6</string>
    <string name="warp_manual_ipv6_body">पिन किए गए एंडपॉइंट के लिए वैकल्पिक IPv6 पता।</string>
    <string name="warp_manual_port_title">मैनुअल एंडपॉइंट पोर्ट</string>
    <string name="warp_manual_port_body">पिन किए गए WARP एंडपॉइंट के लिए UDP पोर्ट।</string>
    <string name="warp_scanner_enabled_title">एंडपॉइंट स्कैनर सक्षम करें</string>
    <string name="warp_scanner_enabled_body">उम्मीदवार WARP एंडपॉइंट की जाँच करें और प्रति नेटवर्क हैंडओवर सर्वोत्तम परिणाम पुनः उपयोग करें।</string>
    <string name="warp_scanner_parallelism_title">स्कैनर समानांतरता</string>
    <string name="warp_scanner_parallelism_body">एक ही समय पर अनुमत एंडपॉइंट जाँचों की अधिकतम संख्या।</string>
    <string name="warp_scanner_rtt_title">अधिकतम एंडपॉइंट RTT</string>
    <string name="warp_scanner_rtt_body">उन स्कैनर उम्मीदवारों को त्यागें जिनकी मापी गई लेटेंसी इस बजट को मिलीसेकंड में पार करती है।</string>
    <string name="warp_amnezia_preset_title">AmneziaWG शेपिंग प्रोफ़ाइल</string>
    <string name="warp_amnezia_preset_body">PayloadGen-समर्थित WARP ऑब्फ़सकेशन प्रीसेट चुनें या कच्चे AmneziaWG मानों को संपादित करने के लिए custom पर स्विच करें।</string>
    <string name="warp_amnezia_profile_title">लागू AmneziaWG प्रोफ़ाइल</string>
    <string name="warp_amnezia_preset_off_summary">WARP के लिए AmneziaWG शेपिंग निष्क्रिय है।</string>
