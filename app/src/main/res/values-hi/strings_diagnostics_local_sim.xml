    <string name="diagnostics_local_hint_airplane_mode">हवाई जहाज़ मोड चालू है। मोबाइल डेटा चाहिए तो जाँचें; Wi-Fi फिर भी काम कर सकता है।</string>
    <string name="diagnostics_local_hint_background_data_restricted">डेटा बचत सीमित डेटा वाले नेटवर्क पर इस ऐप का बैकग्राउंड डेटा सीमित करती है। बैकग्राउंड डेटा सेटिंग जाँचें।</string>
    <string name="diagnostics_local_hint_background_execution_restricted">Android इस ऐप का बैकग्राउंड संचालन सीमित करता है। काम रुकता हो तो ऐप की बैटरी सेटिंग जाँचें।</string>
    <string name="diagnostics_local_hint_power_saver">ऊर्जा बचत चालू है। नेटवर्क काम रुकता हो तो इसे बंद करके तुलना करें।</string>
    <string name="diagnostics_local_hint_device_idle">डिवाइस निष्क्रिय है। उसे जगाएँ और तुलना के लिए जाँच दोहराएँ।</string>
    <string name="diagnostics_local_hint_battery_optimization">इस ऐप पर बैटरी अनुकूलन लागू है। बैकग्राउंड कनेक्शन रुकता हो तो इसकी जाँच करें।</string>
    <string name="diagnostics_local_hint_no_default_data_subscription">डिफ़ॉल्ट डेटा सदस्यता चुनी नहीं गई या अनुपलब्ध है। मोबाइल डेटा SIM का चयन जाँचें।</string>
    <string name="diagnostics_local_hint_subscription_changed">एकत्र करते समय डेटा सदस्यता बदली। बदलाव पूरा होने पर फिर जाँचें।</string>
    <string name="diagnostics_local_hint_active_data_differs">सक्रिय डेटा SIM डिफ़ॉल्ट से अलग है। यह जानकारी सक्रिय मोबाइल मार्ग का वर्णन नहीं कर सकती।</string>
    <string name="diagnostics_local_hint_sim_not_ready">Android के अनुसार यह SIM तैयार नहीं है। SIM की स्थिति जाँचें और डिवाइस के निर्देशों का पालन करें।</string>
    <string name="diagnostics_local_hint_mobile_data_disabled">डिफ़ॉल्ट डेटा SIM का मोबाइल डेटा बंद है। मोबाइल पहुँच चाहिए तो जाँचें।</string>
    <string name="diagnostics_local_hint_data_connection_disallowed">Android इस SIM का डेटा कनेक्शन अनुमत नहीं करता। मोबाइल डेटा सेटिंग जाँचें; कारण निर्धारित नहीं है।</string>
    <string name="diagnostics_local_hint_roaming_disabled">SIM रोमिंग में है और डेटा रोमिंग बंद है। बदलने से पहले सेटिंग और संभावित शुल्क जाँचें।</string>
    <string name="diagnostics_local_hint_voice_service_unavailable">सामान्य वॉइस सेवा अनुपलब्ध है। सिग्नल और SIM सेटिंग जाँचें; यह मोबाइल डेटा की विफलता साबित नहीं करता।</string>
    <string name="diagnostics_local_hint_mobile_data_suspended">मोबाइल डेटा निलंबित है। कॉल या नेटवर्क बदलाव समाप्त होने के बाद फिर जाँचें।</string>
    <string name="diagnostics_local_hint_incomplete_evidence">कुछ जानकारी अज्ञात, अनुपलब्ध है या अनुमति माँगती है। जानकारी न होना विफलता नहीं है; ज़रूरत हो तो फिर जाँचें।</string>
