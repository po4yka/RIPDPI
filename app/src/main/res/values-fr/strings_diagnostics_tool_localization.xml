    <string name="diagnostics_rkn_headline_control_down">résultat indéterminé : connexion témoin indisponible</string>
    <string name="diagnostics_rkn_note_control_down">Une connexion témoin fonctionnelle est nécessaire pour distinguer un blocage d’une panne réseau. Essayez un autre réseau ou vérifiez la connexion locale.</string>
