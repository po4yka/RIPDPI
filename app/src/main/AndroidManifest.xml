<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:ignore="LeanbackUsesWifi" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Per-app VPN split tunneling is a Play-sanctioned use of QUERY_ALL_PACKAGES: the user must be
      able to choose which installed apps are routed through (or bypass) the tunnel, which requires
      enumerating the full installed-app list for the picker. No package data leaves the device.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-feature android:name="android.software.leanback"
        android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera.any"
        android:required="false" />


    <application
        android:name=".RipDpiApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RIPDPI"
        tools:targetApi="34"
        tools:ignore="MissingTvBanner">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RIPDPI.Starting"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ripdpi" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="po4yka.github.io"
                    android:path="/RIPDPI/share" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Import trampoline for inbound proxy share links and subscription deep links.
            Inbound proxy-like URI schemes (vless/vmess/trojan/ss/hysteria/hysteria2/
            tuic/anytls/ssh) are claimed at the default filter priority; the import
            trampoline still validates each payload through the current parser. The
            singbox/ripdpi/sn import-remote-profile deep-link filter sits at a negative
            priority so sing-box-for-Android stays the user's default subscription
            handler when installed; RIPDPI is still offered in the chooser. https:// is
            deliberately never claimed so browser ordering for web links is untouched.
        -->
        <activity
            android:name=".proxyimport.ImportHandlerActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="hysteria" />
                <data android:scheme="hysteria2" />
                <data android:scheme="tuic" />
                <data android:scheme="anytls" />
                <data android:scheme="ssh" />
            </intent-filter>
            <intent-filter android:priority="-100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="singbox" android:host="import-remote-profile" />
                <data android:scheme="ripdpi" android:host="import-remote-profile" />
                <data android:scheme="sn" android:host="import-remote-profile" />
            </intent-filter>
            <intent-filter android:priority="-100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ripdpi" android:host="import" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".activities.MainActivityCleanThemed"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_clean"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_clean_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCleanPlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_clean_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_clean_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCrackedThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_cracked"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_cracked_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCrackedPlain"
