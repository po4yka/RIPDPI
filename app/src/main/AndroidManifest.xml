<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:ignore="LeanbackUsesWifi" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.software.leanback"
        android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen"
        android:required="false" />    

    <application
        android:name=".RipDpiApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RIPDPI"
        tools:targetApi="34"
        tools:ignore="MissingTvBanner">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RIPDPI.Starting"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ripdpi" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity-alias
            android:name=".activities.MainActivityCleanThemed"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_clean"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_clean_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCleanPlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_clean_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_clean_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCrackedThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_cracked"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_cracked_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityCrackedPlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_cracked_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_cracked_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityDisintegrateThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_disintegrate"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_disintegrate_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityDisintegratePlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_disintegrate_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_disintegrate_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityGlitchThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_glitch"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_glitch_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityGlitchPlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_glitch_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_glitch_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityRubbleThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_rubble"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_rubble_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityRubblePlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_rubble_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_rubble_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityStitchThemed"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_stitch"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_stitch_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activities.MainActivityStitchPlain"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".activities.MainActivity"
            android:icon="@mipmap/ic_launcher_ripdpi_stitch_plain"
            android:roundIcon="@mipmap/ic_launcher_ripdpi_stitch_round_plain"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".services.QuickTileService"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action
                    android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_archive_paths" />
        </provider>

        <!--
            WorkManager auto-initialization is disabled here so the Hilt-aware
            Configuration.Provider on RipDpiApp wires up the HiltWorkerFactory
            before any worker is instantiated. Without this override, the
            default factory would race the Hilt graph and fail to construct
            @HiltWorker classes.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
