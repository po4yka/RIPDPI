<resources>
    <string name="config_chain_editor_helper_full">The HTTPS section below can author single tlsrec and randomized tlsrandrec steps visually, while the Hostfake and fake approximation cards explain hostname-targeted fake chunks and retransmission-style approximations. Linux/Android-only approximations are available as fakedsplit host+1 and fakeddisorder endhost for HTTP or TLS SNI-adjacent payloads.</string>
    <string name="config_placeholder_chain_dsl">[tcp]
tlsrec extlen
hostfake endhost+8 midhost=midsld host=googlevideo.com
split midsld

[udp]
fake_burst 3</string>
    <string name="ripdpi_hostfake_available_title">Hostname targeting available</string>
    <string name="ripdpi_hostfake_available_body">Add a hostfake step when you want fake chunks only around the HTTP Host or TLS SNI span instead of faking the whole payload.</string>
    <string name="ripdpi_hostfake_ready_title">Hostfake configured</string>
    <string name="ripdpi_hostfake_ready_body">Hostfake needs root and raw packet support. Otherwise, RIPDPI uses a plain split.</string>
    <string name="ripdpi_hostfake_restart_title">Restart to apply hostfake</string>
    <string name="ripdpi_hostfake_restart_body">Hostfake is configured in settings, but the running RIPDPI session started before this chain change.</string>
    <string name="ripdpi_hostfake_protocols_off_title">HTTP and HTTPS are off</string>
    <string name="ripdpi_hostfake_protocols_off_body">Enable HTTP or HTTPS bypass strategy if you want hostfake to target Host or SNI fields.</string>
    <string name="ripdpi_hostfake_cli_title">Controlled by command line</string>
    <string name="ripdpi_hostfake_cli_body">Visual hostfake guidance stays visible here, but the active chain comes from raw RIPDPI arguments while command line settings are enabled.</string>
