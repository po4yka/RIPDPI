<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:usesCleartextTraffic="true">
        <service
            android:name="com.poyka.ripdpi.e2e.TestNetworkProbeService"
            android:enabled="true"
            android:exported="true"
            android:process=":network_probe" />

        <receiver
            android:name="com.poyka.ripdpi.e2e.TestNetworkProbeReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.poyka.ripdpi.permission.TEST_NETWORK_PROBE"
            android:process=":network_probe">
            <intent-filter>
                <action android:name="com.poyka.ripdpi.debug.PROBE_TCP" />
                <action android:name="com.poyka.ripdpi.debug.PROBE_UDP" />
                <action android:name="com.poyka.ripdpi.debug.PROBE_DNS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
