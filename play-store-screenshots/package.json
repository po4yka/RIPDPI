{
  "name": "play-store-screenshots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "capture:prod": "python3 scripts/validate-source-captures.py && node --test scripts/test-marketing-fonts.mjs && next build && node scripts/capture-prod.mjs && node scripts/validate-play-store.mjs --strict",
    "validate": "node scripts/validate-play-store.mjs --strict",
    "validate:sources": "python3 scripts/validate-source-captures.py",
    "test:sources": "python3 -m unittest discover -s scripts -p 'test_source_captures.py'",
    "test:fonts": "node --test scripts/test-marketing-fonts.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "puppeteer",
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
