<?xml version="1.0" encoding="UTF-8"?>
<!--
  RIPDPI journey: settings navigation. Mirrors maestro/02-settings-navigation.yaml.
  Schema (root <journey> + <description> + <actions>/<action>) follows the Android
  Studio "New > Journey Test" template; confirm against the installed Android
  CLI 1.0 template before this lane gates merges. See journeys/README.md.
-->
<journey name="02-settings-navigation">
  <description>
    Navigation smoke test: from the Home screen, reach the Advanced Settings
    screen through the Settings tab.
  </description>
  <actions>
    <action>Launch the RIPDPI app from a cold start (force-stop it first if running).</action>
    <action>Confirm the Home screen is displayed.</action>
    <action>Tap the "Settings" item in the bottom navigation bar.</action>
    <action>Confirm the Settings screen is displayed.</action>
    <action>Open "Advanced settings" from the Settings screen, scrolling down if needed to find it.</action>
    <action>Confirm the Advanced settings screen is displayed.</action>
  </actions>
</journey>
