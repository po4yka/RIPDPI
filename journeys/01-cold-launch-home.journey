<?xml version="1.0" encoding="UTF-8"?>
<!--
  RIPDPI journey: cold launch to Home. Mirrors maestro/01-cold-launch-home.yaml.
  Schema (root <journey> + <description> + <actions>/<action>) follows the Android
  Studio "New > Journey Test" template; confirm against the installed Android
  CLI 1.0 template before this lane gates merges. See journeys/README.md.
-->
<journey name="01-cold-launch-home">
  <description>
    Cold-launch smoke test: the RIPDPI app starts to the Home screen and the
    primary local DPI-bypass mode is visible.
  </description>
  <actions>
    <action>Launch the RIPDPI app from a cold start (force-stop it first if running).</action>
    <action>Confirm the Home screen is displayed.</action>
    <action>Expand the "Modes &amp; diagnostics" section.</action>
    <action>Confirm the primary "Local DPI bypass" mode is visible on the Home screen.</action>
  </actions>
</journey>
