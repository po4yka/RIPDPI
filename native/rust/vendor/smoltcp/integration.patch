+    fn test_syn_mss_controls_passive_payload_size() {
+        for (option, expected) in [
+            (None, family_default_mss()),
+            (Some(0), family_default_mss()),
+            (Some(1000), 1000),
+            (Some(10), 48),
+        ] {
+            let mut s = socket_with_buffer_sizes(2048, 2048);
+            s.listen(LOCAL_PORT).unwrap();
+            send!(
+                s,
+                TcpRepr {
+                    control: TcpControl::Syn,
+                    seq_number: REMOTE_SEQ,
+                    ack_number: None,
+                    max_seg_size: option,
+                    window_len: 4096,
+                    ..SEND_TEMPL
+                }
+            );
+            recv(&mut s, Instant::ZERO, |packet| {
+                assert_eq!(packet.unwrap().control, TcpControl::Syn)
+            });
+            send!(
+                s,
+                TcpRepr {
+                    seq_number: REMOTE_SEQ + 1,
+                    ack_number: Some(LOCAL_SEQ + 1),
+                    window_len: 4096,
+                    ..SEND_TEMPL
+                }
+            );
+            s.send_slice(&[0x5a; 2048]).unwrap();
+            recv(&mut s, Instant::ZERO, |packet| {
+                let packet = packet.unwrap();
+                assert_eq!(packet.payload, &[0x5a; 2048][..expected]);
+            });
+        }
+    }
