+#[cfg(test)]
+mod integration_patch_tests {
+    use super::*;
+    use crate::config::ServerType;
+
+    fn fixed_context(timestamp: u64) -> Context {
+        let mut context = Context::new(ServerType::Local);
+        context.set_timestamp_provider(Arc::new(move || timestamp));
+        context
+    }
+
+    #[test]
+    fn independent_clock_unaligned_datagrams_and_authenticated_metadata() {
+        for method in [
+            CipherKind::AEAD2022_BLAKE3_AES_128_GCM,
+            CipherKind::AEAD2022_BLAKE3_AES_256_GCM,
+            CipherKind::AEAD2022_BLAKE3_CHACHA20_POLY1305,
+        ] {
+            let sender = fixed_context(1_234_567);
+            let receiver = fixed_context(1_234_568);
+            let stale_receiver = fixed_context(1_234_700);
+            let key = vec![0x3a; method.key_len()];
+            let address = Address::from("127.0.0.1:8080".parse::<std::net::SocketAddr>().unwrap());
+            let control = UdpSocketControlData {
+                client_session_id: 42,
+                server_session_id: 99,
+                packet_id: 7,
+                ..Default::default()
+            };
+            for server_packet in [false, true] {
+                let mut packet = BytesMut::new();
+                if server_packet {
+                    encrypt_server_payload_aead_2022(&sender, method, &key, &address, &control, b"clock", &mut packet);
+                } else {
+                    encrypt_client_payload_aead_2022(
+                        &sender,
+                        method,
+                        &key,
+                        &address,
+                        &control,
+                        &[],
+                        b"clock",
+                        &mut packet,
+                    );
+                }
+                let mut aligned_storage = vec![0u8; packet.len() + 8];
+                let offset = (1 + 8 - aligned_storage.as_ptr() as usize % 8) % 8;
+                aligned_storage[offset..offset + packet.len()].copy_from_slice(&packet);
+                let unaligned = &mut aligned_storage[offset..offset + packet.len()];
+                assert_ne!(unaligned.as_ptr() as usize % 8, 0);
+                let (len, target, authenticated) = if server_packet {
+                    decrypt_server_payload_aead_2022(&receiver, method, &key, unaligned).unwrap()
+                } else {
+                    decrypt_client_payload_aead_2022(&receiver, method, &key, unaligned, None).unwrap()
+                };
+                assert_eq!(&unaligned[..len], b"clock");
+                assert_eq!(target, address);
+                assert_eq!(authenticated.client_session_id, 42);
+                assert_eq!(authenticated.packet_id, 7);
+                assert_eq!(authenticated.authenticated_timestamp, Some(1_234_567));
+                let stale_result = if server_packet {
+                    decrypt_server_payload_aead_2022(&stale_receiver, method, &key, &mut packet)
+                } else {
+                    decrypt_client_payload_aead_2022(&stale_receiver, method, &key, &mut packet, None)
+                };
+                assert!(matches!(stale_result, Err(ProtocolError::InvalidTimestamp(1_234_567, 1_234_700))));
+            }
+        }
+    }
+
+    #[test]
+    fn cache_uses_key_value_after_same_allocation_changes() {
+        let context = fixed_context(1234);
+        let method = CipherKind::AEAD2022_BLAKE3_AES_128_GCM;
+        let address = Address::from("127.0.0.1:80".parse::<std::net::SocketAddr>().unwrap());
+        let control = UdpSocketControlData { server_session_id: 19, ..Default::default() };
+        let mut reused_key = [0x11; 16];
+        let mut first = BytesMut::new();
+        encrypt_server_payload_aead_2022(&context, method, &reused_key, &address, &control, b"first", &mut first);
+        reused_key.fill(0x22);
+        let mut second = BytesMut::new();
+        encrypt_server_payload_aead_2022(&context, method, &reused_key, &address, &control, b"second", &mut second);
+        let independent_key = [0x22; 16];
+        let (len, _, _) = decrypt_server_payload_aead_2022(&context, method, &independent_key, &mut second).unwrap();
+        assert_eq!(&second[..len], b"second");
+    }
+
+    #[test]
+    fn authenticated_short_server_header_returns_error() {
+        let context = fixed_context(1234);
+        let method = CipherKind::AEAD2022_BLAKE3_AES_128_GCM;
+        let key = [0x44; 16];
+        let mut packet = BytesMut::new();
+        packet.put_u64(19);
+        packet.put_u64(1);
+        packet.put_u8(SERVER_SOCKET_TYPE);
+        packet.put_u64(1234);
+        packet.put_u16(0);
+        encrypt_message(&context, method, &key, &key, &mut packet, 19, 0);
+        assert!(matches!(
+            decrypt_server_payload_aead_2022(&context, method, &key, &mut packet),
+            Err(ProtocolError::PacketTooShort(_, _))
+        ));
+    }
+}
