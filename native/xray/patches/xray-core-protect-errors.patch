+// Empty UDP packets still own buffers and must consume the pipe budget.
+func (p *pipe) bufferedSize() int32 {
+	size := p.data.Len()
+	for _, b := range p.data {
+		if b != nil && b.UDP != nil && b.IsEmpty() {
+			size += max(b.Cap(), 1)
+		}
+	}
+	return size
