+package socks
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+type managedControlRegistry struct {
+	sync.Mutex
+	closed bool
+	active map[*managedControl]struct{}
+}
+
+type managedControl struct {
+	sync.Mutex
+	control  net.Conn
+	relay    net.PacketConn
+	cancel   context.CancelFunc
+	stopOnce sync.Once
+	closed   bool
+	done     chan struct{}
+}
+
+func (o *managedControl) attachRelay(relay net.PacketConn) bool {
+	o.Lock()
+	defer o.Unlock()
+	if o.closed {
+		return false
+	}
+	o.relay = relay
+	return true
+}
+
+func (o *managedControl) stop() {
+	o.stopOnce.Do(func() {
+		o.Lock()
+		o.closed = true
+		relay := o.relay
+		o.Unlock()
+		o.cancel()
+		o.control.Close()
+		if relay != nil {
+			relay.Close()
+		}
+	})
+}
+
+func (s *Server) registerManagedControl(ctx context.Context, control net.Conn) (context.Context, *managedControl, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	owner := &managedControl{control: control, cancel: cancel, done: make(chan struct{})}
+	s.managedControls.Lock()
+	if s.managedControls.closed {
+		s.managedControls.Unlock()
+		owner.stop()
+		return ctx, nil, errors.New("managed SOCKS server is closed")
+	}
+	if s.managedControls.active == nil {
+		s.managedControls.active = make(map[*managedControl]struct{})
+	}
+	s.managedControls.active[owner] = struct{}{}
+	s.managedControls.Unlock()
+	context.AfterFunc(ctx, owner.stop)
+	return ctx, owner, nil
+}
+
+func (s *Server) retireManagedControl(owner *managedControl) {
+	owner.stop()
+	s.managedControls.Lock()
+	delete(s.managedControls.active, owner)
+	close(owner.done)
+	s.managedControls.Unlock()
+}
+
+// Close is called by the inbound worker even when its connection context is Background.
+func (s *Server) Close() error {
+	s.managedControls.Lock()
+	s.managedControls.closed = true
+	active := make([]*managedControl, 0, len(s.managedControls.active))
+	for owner := range s.managedControls.active {
+		active = append(active, owner)
+	}
+	s.managedControls.Unlock()
+	deadline := time.NewTimer(2 * time.Second)
+	defer deadline.Stop()
+	for _, owner := range active {
+		go owner.stop()
+	}
+	for _, owner := range active {
+		select {
+		case <-owner.done:
+		case <-deadline.C:
+			return errors.New("managed SOCKS controls did not stop before deadline")
+		}
+	}
+	return nil
+}
