+package socks
+
+import (
+	"context"
+	"encoding/binary"
+	"strings"
+	"sync"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	udp_proto "github.com/xtls/xray-core/common/protocol/udp"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/udp"
+)
+
+const managedInboundTag = "ripdpi-managed-socks-in-v1"
+const maxManagedUDPAuthorities = 256
+
+// The private local hop carries both DNS authority and the admitted numeric pin.
+type managedUDPAuthority struct {
+	host        string
+	destination net.Destination
+}
+
+func (s *Server) acceptsManagedUDP(ctx context.Context) bool {
+	inbound := session.InboundFromContext(ctx)
+	return s.config.AuthType == AuthType_PASSWORD && inbound != nil && inbound.Tag == managedInboundTag &&
+		inbound.Gateway.IsValid() && inbound.Gateway.Address.Family().IsIP() && inbound.Gateway.Address.IP().IsLoopback()
+}
+
+func decodeManagedUDP(packet *buf.Buffer) (managedUDPAuthority, []byte, error) {
+	var authority managedUDPAuthority
+	frame := packet.Bytes()
+	if len(frame) < 6 || frame[0] != 0 || frame[1] != 0 || frame[2] != 0 || frame[3] != 5 || frame[4] == 0 {
+		return authority, nil, errors.New("invalid managed UDP header")
+	}
+	hostEnd := 5 + int(frame[4])
+	if len(frame) <= hostEnd {
+		return authority, nil, errors.New("truncated managed UDP host")
+	}
+	host := strings.ToLower(strings.TrimSuffix(string(frame[5:hostEnd]), "."))
+	if host == "" {
+		return authority, nil, errors.New("empty managed UDP host")
+	}
+	for _, c := range host {
+		if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '.' || c == '-' || c == '_') {
+			return authority, nil, errors.New("invalid managed UDP host")
+		}
+	}
+	ipLen := 0
+	switch frame[hostEnd] {
+	case 1:
+		ipLen = 4
+	case 4:
+		ipLen = 16
+	default:
+		return authority, nil, errors.New("invalid managed UDP pin family")
+	}
+	end := hostEnd + 1 + ipLen + 2
+	if len(frame) < end {
+		return authority, nil, errors.New("truncated managed UDP pin")
+	}
+	authority = managedUDPAuthority{
+		host:        host,
+		destination: net.UDPDestination(net.IPAddress(frame[hostEnd+1:hostEnd+1+ipLen]), net.Port(binary.BigEndian.Uint16(frame[end-2:end]))),
+	}
+	// Preserve the admitted authority in the reply even when the relay returns a numeric source.
+	header := append([]byte(nil), frame[:end]...)
+	packet.Advance(int32(end))
+	return authority, header, nil
+}
+
+type managedUDPEntry struct {
+	sync.Mutex
+	dispatcher *udp.Dispatcher
+	closed     bool
+}
+
+func (e *managedUDPEntry) close() {
+	e.Lock()
+	e.closed = true
+	e.Unlock()
+	e.dispatcher.RemoveRay()
+}
+
+type managedUDPDispatch struct {
+	entries    map[managedUDPAuthority]*managedUDPEntry
+	dispatcher routing.Dispatcher
+	conn       stat.Connection
+}
+
+func (d *managedUDPDispatch) close() {
+	for _, entry := range d.entries {
+		entry.close()
+	}
+}
+
+func (d *managedUDPDispatch) dispatch(ctx context.Context, payload *buf.Buffer) {
+	authority, header, err := decodeManagedUDP(payload)
+	if err != nil || ctx.Err() != nil {
+		payload.Release()
+		return
+	}
+	entry := d.entries[authority]
+	if entry != nil && !entry.dispatcher.IsActive() {
+		entry.close()
+		delete(d.entries, authority)
+		entry = nil
+	}
+	if entry == nil {
+		// Idle rays own their existing timeout. Prune only rays that have already closed.
+		if len(d.entries) >= maxManagedUDPAuthorities {
+			for key, stale := range d.entries {
+				if !stale.dispatcher.IsActive() {
+					stale.close()
+					delete(d.entries, key)
+				}
+			}
+		}
+		if len(d.entries) >= maxManagedUDPAuthorities {
+			payload.Release()
+			return
+		}
+		entry = &managedUDPEntry{}
+		entry.dispatcher = udp.NewDispatcher(d.dispatcher, func(responseCtx context.Context, packet *udp_proto.Packet) {
+			defer packet.Payload.Release()
+			entry.Lock()
+			defer entry.Unlock()
+			if entry.closed || responseCtx.Err() != nil || !packet.Source.IsValid() ||
+				packet.Source.Network != net.Network_UDP || packet.Source.Port != authority.destination.Port ||
+				!packet.Source.Address.Family().IsIP() || !packet.Source.Address.IP().Equal(authority.destination.Address.IP()) {
+				return
+			}
+			response := make([]byte, 0, len(header)+int(packet.Payload.Len()))
+			response = append(response, header...)
+			response = append(response, packet.Payload.Bytes()...)
+			d.conn.Write(response)
+		})
+		d.entries[authority] = entry
+	}
+	// The route uses the domain. The outbound socket uses the exact admitted IP.
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{
+		RouteTarget: net.UDPDestination(net.DomainAddress(authority.host), authority.destination.Port),
+	}})
+	payload.UDP = &authority.destination
+	entry.dispatcher.Dispatch(ctx, authority.destination, payload)
+}
