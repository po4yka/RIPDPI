+package socks
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/binary"
+	"io"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+const managedUDPCommand = 0x80
+const managedUDPHeader = 32
+const managedUDPMaxWire = 65507
+
+// RUF1 is the existing authenticated local-hop contract in ripdpi-socks5-core.
+type managedUDPConn struct {
+	net.PacketConn
+	peer   *net.UDPAddr
+	nonce  [16]byte
+	lastID uint64
+	buffer [buf.Size + managedUDPHeader + 1]byte
+}
+
+func (c *managedUDPConn) RemoteAddr() net.Addr { return c.peer }
+
+func (c *managedUDPConn) Read(payload []byte) (int, error) {
+	for {
+		n, source, err := c.PacketConn.ReadFrom(c.buffer[:])
+		if err != nil {
+			return 0, err
+		}
+		peer, ok := source.(*net.UDPAddr)
+		frame := c.buffer[:n]
+		if !ok || peer.Port != c.peer.Port || !peer.IP.Equal(c.peer.IP) ||
+			n < managedUDPHeader || n > managedUDPMaxWire || string(frame[:4]) != "RUF1" ||
+			frame[4] != 1 || frame[5] != 0 ||
+			int(binary.BigEndian.Uint16(frame[6:8])) != n-managedUDPHeader ||
+			n-managedUDPHeader > len(payload) || subtle.ConstantTimeCompare(frame[8:24], c.nonce[:]) != 1 {
+			continue
+		}
+		id := binary.BigEndian.Uint64(frame[24:32])
+		if id <= c.lastID {
+			continue
+		}
+		c.lastID = id
+		return copy(payload, frame[managedUDPHeader:]), nil
+	}
+}
+
+func (c *managedUDPConn) Write(payload []byte) (int, error) {
+	if len(payload) > managedUDPMaxWire-managedUDPHeader {
+		return 0, errors.New("managed UDP response exceeds wire limit")
+	}
+	frame := make([]byte, managedUDPHeader+len(payload))
+	copy(frame, "RUF1")
+	frame[4] = 2
+	binary.BigEndian.PutUint16(frame[6:8], uint16(len(payload)))
+	copy(frame[8:24], c.nonce[:])
+	copy(frame[managedUDPHeader:], payload)
+	n, err := c.PacketConn.WriteTo(frame, c.peer)
+	if err != nil {
+		return 0, err
+	}
+	if n != len(frame) {
+		return 0, io.ErrShortWrite
+	}
+	return len(payload), nil
+}
+
+func (s *Server) handleManagedUDP(ctx context.Context, control stat.Connection, reader io.Reader, dispatcher routing.Dispatcher, request *protocol.RequestHeader, owner *managedControl) error {
+	peer, ok := control.RemoteAddr().(*net.TCPAddr)
+	if !ok || !request.Address.Family().IsIP() || request.Port == 0 ||
+		!request.Address.IP().IsLoopback() || !request.Address.IP().Equal(peer.IP) {
+		writeSocks5Response(control, statusCmdNotSupport, net.AnyIP, net.Port(0))
+		return errors.New("managed UDP requires the authenticated peer source endpoint")
+	}
+	local := control.LocalAddr().(*net.TCPAddr)
+	relay, err := internet.ListenSystemPacket(ctx, &net.UDPAddr{IP: local.IP}, nil)
+	if err != nil {
+		return err
+	}
+	defer relay.Close()
+	if owner == nil || !owner.attachRelay(relay) {
+		return errors.New("managed control is closed")
+	}
+	conn := &managedUDPConn{PacketConn: relay, peer: &net.UDPAddr{IP: peer.IP, Port: int(request.Port)}}
+	if _, err := io.ReadFull(rand.Reader, conn.nonce[:]); err != nil {
+		return err
+	}
+	bound := relay.LocalAddr().(*net.UDPAddr)
+	if err := writeSocks5Response(control, statusSuccess, net.IPAddress(bound.IP), net.Port(bound.Port)); err != nil {
+		return err
+	}
+	preface := append([]byte("RUF1"), conn.nonce[:]...)
+	if err := buf.WriteAllBytes(control, preface, nil); err != nil {
+		return err
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		// EOF or unexpected control data revokes this association.
+		var extra [1]byte
+		reader.Read(extra[:])
+		owner.stop()
+	}()
+	defer func() {
+		owner.stop()
+		<-done
+	}()
+	return s.handleUDPPayload(ctx, conn, dispatcher)
+}
