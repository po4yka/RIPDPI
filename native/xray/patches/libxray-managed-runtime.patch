-		return conn.Control(controller)
+		return protectSocket(conn, controller)
@@ -25,0 +27,12 @@ func RegisterListenerController(controller func(fd uintptr)) {
+
+// A denied callback must abort the owning Go dial/listen operation.
+func protectSocket(conn syscall.RawConn, controller func(uintptr) bool) error {
+	allowed := false
+	if err := conn.Control(func(fd uintptr) { allowed = controller != nil && controller(fd) }); err != nil {
+		return err
+	}
+	if !allowed {
+		return errors.New("VPN socket protection denied")
+	}
+	return nil
+}
