+package stun
+
+import (
+	"fmt"
+	"github.com/pion/transport/v4/vnet"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+)
+
+func TestPublicNetScopedIPv6(t *testing.T) {
+	if got, err := scopedUDPAddr(nil); got != nil || err != nil {
+		t.Fatalf("nil: %v %v", got, err)
+	}
+	mapped := "[::ffff:127.0.0.1%irrelevant-zone]:7"
+	if got, err := scopedAddress(mapped); got != mapped || err != nil {
+		t.Fatalf("mapped IPv4 zone: %q %v", got, err)
+	}
+	unspecified := &net.UDPAddr{Zone: "irrelevant-zone"}
+	if got, err := scopedUDPAddr(unspecified); got != unspecified || err != nil {
+		t.Fatalf("unspecified zone: %v %v", got, err)
+	}
+	ipv4 := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Zone: "irrelevant-zone"}
+	if got, err := scopedUDPAddr(ipv4); got != ipv4 || err != nil {
+		t.Fatalf("IPv4 zone: %v %v", got, err)
+	}
+	if got, err := numericZone("4294967295"); got != "4294967295" || err != nil {
+		t.Fatalf("uint32 scope: %s %v", got, err)
+	}
+	for _, zone := range []string{"4294967296", "lo\x00ignored"} {
+		if _, err := numericZone(zone); err == nil {
+			t.Fatalf("invalid zone accepted: %q", zone)
+		}
+	}
+
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var loop net.Interface
+	for _, iface := range interfaces {
+		if iface.Flags&net.FlagLoopback != 0 {
+			loop = iface
+			break
+		}
+	}
+	if loop.Index == 0 {
+		t.Fatal("loopback interface missing")
+	}
+	numeric := strconv.Itoa(loop.Index)
+	for _, zone := range []string{loop.Name, numeric, ""} {
+		t.Run("zone="+zone, func(t *testing.T) {
+			got, err := numericZone(zone)
+			want := numeric
+			if zone == "" {
+				want = ""
+			}
+			if err != nil || got != want {
+				t.Fatalf("zone: got %q, %v; want %q", got, err, want)
+			}
+			original := &net.UDPAddr{IP: net.IPv6loopback, Zone: zone}
+			normalized, err := scopedUDPAddr(original)
+			if err != nil || normalized.Zone != want || original.Zone != zone {
+				t.Fatalf("UDP zone/input mutation: %v %v", normalized, err)
+			}
+			server, err := net.ListenUDP("udp6", &net.UDPAddr{IP: net.IPv6loopback})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			if err := server.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
+				t.Fatal(err)
+			}
+			target := *server.LocalAddr().(*net.UDPAddr)
+			target.Zone = zone
+			host := "::1"
+			if zone != "" {
+				host += "%" + zone
+			}
+			address := net.JoinHostPort(host, strconv.Itoa(target.Port))
+			normalizedText, err := scopedAddress(address)
+			wantHost := "::1"
+			if want != "" {
+				wantHost += "%" + want
+			}
+			if err != nil || normalizedText != net.JoinHostPort(wantHost, strconv.Itoa(target.Port)) {
+				t.Fatalf("address: %s %v", normalizedText, err)
+			}
+			clients := []func() (net.Conn, error){
+				func() (net.Conn, error) { return (publicNet{}).Dial("udp6", address) },
+				func() (net.Conn, error) { return (publicNet{}).DialUDP("udp6", original, &target) },
+			}
+			for i, dial := range clients {
+				client, err := dial()
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer client.Close()
+				if original.Zone != zone || target.Zone != zone {
+					t.Fatal("caller UDPAddr was modified")
+				}
+				if err := client.SetDeadline(time.Now().Add(2 * time.Second)); err != nil {
+					t.Fatal(err)
+				}
+				payload := []byte(fmt.Sprintf("scoped-%s-%d", zone, i))
+				if _, err := client.Write(payload); err != nil {
+					t.Fatal(err)
+				}
+				buf := make([]byte, 128)
+				count, source, err := server.ReadFromUDP(buf)
+				if err != nil || string(buf[:count]) != string(payload) {
+					t.Fatalf("server: %q %v", buf[:count], err)
+				}
+				if _, err := server.WriteToUDP(buf[:count], source); err != nil {
+					t.Fatal(err)
+				}
+				count, err = client.Read(buf)
+				if err != nil || string(buf[:count]) != string(payload) {
+					t.Fatalf("reply: %q %v", buf[:count], err)
+				}
+			}
+		})
+	}
+	if _, err := numericZone("no-such-ripdpi0"); err == nil {
+		t.Fatal("unknown named zone accepted")
+	}
+}
+
+func TestDialURICustomNet(t *testing.T) {
+	virtual, err := vnet.NewNet(&vnet.NetConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := virtual.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	if err := server.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	uri, err := ParseURI("stun:" + server.LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := &DialConfig{Net: virtual}
+	client, err := DialURI(uri, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	request := MustBuild(TransactionID, BindingRequest)
+	if _, err := client.c.Write(request.Raw); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 1024)
+	size, _, err := server.ReadFrom(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message := New()
+	if err := Decode(buf[:size], message); err != nil {
+		t.Fatal(err)
+	}
+	if message.Type != BindingRequest || message.TransactionID != request.TransactionID {
+		t.Fatal("custom network did not deliver STUN request")
+	}
+	if config.Net != virtual {
+		t.Fatal("caller network was modified")
+	}
+}
