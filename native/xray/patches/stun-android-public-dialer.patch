+//go:build !android
+
+package stun
+
+import (
+	"github.com/pion/transport/v4/stdnet"
+	"net"
+)
+
+func newDefaultNet() (dialNet, error) { return stdnet.NewNet() }
+func interfaceIndex(name string) (int, error) {
+	iface, err := net.InterfaceByName(name)
+	if err != nil {
+		return 0, err
+	}
+	return iface.Index, nil
+}
