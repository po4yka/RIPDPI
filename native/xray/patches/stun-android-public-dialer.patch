+package stun
+
+import (
+	"github.com/pion/transport/v4"
+	"net"
+	"strconv"
+	"strings"
+)
+
+// DialURI needs dialing only; interface enumeration is not part of its contract.
+type dialNet interface {
+	Dial(string, string) (net.Conn, error)
+	DialUDP(string, *net.UDPAddr, *net.UDPAddr) (transport.UDPConn, error)
+}
+type publicNet struct{}
+
+func numericZone(zone string) (string, error) {
+	if zone == "" {
+		return zone, nil
+	}
+	if strings.IndexByte(zone, 0) >= 0 {
+		return "", &net.AddrError{Err: "invalid IPv6 zone", Addr: zone}
+	}
+	if _, err := strconv.ParseUint(zone, 10, 32); err == nil {
+		return zone, nil
+	}
+	index, err := interfaceIndex(zone)
+	if err != nil {
+		return "", err
+	}
+	return strconv.Itoa(index), nil
+}
+func scopedAddress(address string) (string, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return address, nil
+	}
+	ip, zone, found := strings.Cut(host, "%")
+	parsed := net.ParseIP(ip)
+	if !found || parsed == nil || parsed.To4() != nil {
+		return address, nil
+	}
+	zone, err = numericZone(zone)
+	if err != nil {
+		return "", err
+	}
+	return net.JoinHostPort(ip+"%"+zone, port), nil
+}
+func scopedUDPAddr(address *net.UDPAddr) (*net.UDPAddr, error) {
+	if address == nil || address.Zone == "" || address.IP.To16() == nil || address.IP.To4() != nil {
+		return address, nil
+	}
+	zone, err := numericZone(address.Zone)
+	if err != nil {
+		return nil, err
+	}
+	copy := *address
+	copy.Zone = zone
+	return &copy, nil
+}
+func (publicNet) Dial(network, address string) (net.Conn, error) {
+	address, err := scopedAddress(address)
+	if err != nil {
+		return nil, err
+	}
+	return net.Dial(network, address)
+}
+func (publicNet) DialUDP(network string, local, remote *net.UDPAddr) (transport.UDPConn, error) {
+	local, err := scopedUDPAddr(local)
+	if err != nil {
+		return nil, err
+	}
+	remote, err = scopedUDPAddr(remote)
+	if err != nil {
+		return nil, err
+	}
+	return net.DialUDP(network, local, remote)
+}
