# Files copied into every Claude Code worktree (.claude/worktrees/<slug>/).
#
# Syntax is .gitignore-style. Only paths that match a pattern AND are
# gitignored are copied, so tracked files are never duplicated. Without this,
# a fresh worktree has no Android SDK path, so the native/Gradle build fails
# on first run. Run `just setup` in the new worktree for the remaining tools.
#
# See docs/contributor/build-performance.md "Worktree builds" and
# AGENTS.md "Worktree and commit workflow".

# Android SDK location — Gradle/native build cannot resolve the SDK without it.
local.properties

# Personal Claude Code permissions, plugins, and MCP servers.
.claude/settings.local.json

# Local environment overrides, if present.
.env
.env.local
