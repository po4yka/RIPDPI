{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://po4yka.github.io/RIPDPI/schemas/network-evidence-manifest-v2.schema.json",
  "title": "RIPDPI redacted dual-vantage network evidence manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceSha",
    "appliesTo",
    "correlationId",
    "generatedAtEpoch",
    "provenance",
    "artifacts",
    "scenarios",
    "gateResults"
  ],
  "properties": {
    "version": {
      "const": "network_evidence_manifest_v2"
    },
    "sourceSha": {
      "$ref": "#/$defs/sha1"
    },
    "appliesTo": {
      "enum": [
        "android-client-release",
        "fleet-profile-rollout"
      ]
    },
    "correlationId": {
      "$ref": "#/$defs/sha256"
    },
    "generatedAtEpoch": {
      "$ref": "#/$defs/positiveInteger"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "gateResults": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "INCONCLUSIVE"
        ]
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionKind",
        "executionId",
        "executionAttempt",
        "executionDefinition",
        "runnerSha256",
        "validatorSha256",
        "policySha256",
        "producerPolicySha256",
        "scenarioPlanSha256",
        "workloadSha256",
        "clientArtifactSha256",
        "testArtifactSha256"
      ],
      "properties": {
        "executionKind": {
          "enum": [
            "github-actions",
            "local"
          ]
        },
        "executionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "executionAttempt": {
          "$ref": "#/$defs/positiveInteger"
        },
        "executionDefinition": {
          "type": "string",
          "enum": [
            ".github/workflows/dns-ipv6-killswitch-evidence.yml",
            "local"
          ]
        },
        "runnerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "validatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "policySha256": {
          "$ref": "#/$defs/sha256"
        },
        "producerPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenarioPlanSha256": {
          "$ref": "#/$defs/sha256"
        },
        "workloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "clientArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testArtifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionKind": {
                "const": "github-actions"
              }
            }
          },
          "then": {
            "properties": {
              "executionDefinition": {
                "const": ".github/workflows/dns-ipv6-killswitch-evidence.yml"
              }
            }
          },
          "else": {
            "properties": {
              "executionDefinition": {
                "const": "local"
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "rawCaptureSha256",
        "vantageIdSha256",
        "networkIdSha256",
        "collectorSha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "client-underlay",
            "external-observer"
          ]
        },
        "path": {
          "enum": [
            "client-observation.json",
            "observer-observation.json"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rawCaptureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "vantageIdSha256": {
          "$ref": "#/$defs/sha256"
        },
        "networkIdSha256": {
          "$ref": "#/$defs/sha256"
        },
        "collectorSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startedAtEpoch",
        "finishedAtEpoch",
        "actionMarkerSha256",
        "outcomeMarkerSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "kind": {
          "enum": [
            "dns",
            "ipv6",
            "direct_window"
          ]
        },
        "startedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "finishedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "actionMarkerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcomeMarkerSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceSha",
        "correlationId",
        "role",
        "vantageIdSha256",
        "networkIdSha256",
        "collectorSha256",
        "clientArtifactSha256",
        "testArtifactSha256",
        "scenarioPlanSha256",
        "captureStartedAtEpoch",
        "captureFinishedAtEpoch",
        "rawCaptureSha256",
        "windows"
      ],
      "properties": {
        "version": {
          "const": "network_evidence_observation_v2"
        },
        "sourceSha": {
          "$ref": "#/$defs/sha1"
        },
        "correlationId": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "client-underlay",
            "external-observer"
          ]
        },
        "vantageIdSha256": {
          "$ref": "#/$defs/sha256"
        },
        "networkIdSha256": {
          "$ref": "#/$defs/sha256"
        },
        "collectorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "clientArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenarioPlanSha256": {
          "$ref": "#/$defs/sha256"
        },
        "captureStartedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "captureFinishedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "rawCaptureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/window"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startedAtEpoch",
        "finishedAtEpoch",
        "expectedPacketCount",
        "unexpectedPacketCount",
        "captureErrorCount",
        "actionMarkerSha256",
        "outcomeMarkerSha256",
        "actionObservedCount",
        "outcomeObservedCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "kind": {
          "enum": [
            "dns",
            "ipv6",
            "direct_window"
          ]
        },
        "startedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "finishedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "expectedPacketCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "unexpectedPacketCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "captureErrorCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "actionMarkerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcomeMarkerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "actionObservedCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "outcomeObservedCount": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "scenarioPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceSha",
        "correlationId",
        "clientArtifactSha256",
        "testArtifactSha256",
        "windows"
      ],
      "properties": {
        "version": {
          "const": "network_evidence_scenario_plan_v2"
        },
        "sourceSha": {
          "$ref": "#/$defs/sha1"
        },
        "correlationId": {
          "$ref": "#/$defs/sha256"
        },
        "clientArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planWindow"
          }
        }
      }
    },
    "planWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startedAtEpoch",
        "finishedAtEpoch",
        "actionMarkerSha256",
        "outcomeMarkerSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "kind": {
          "enum": [
            "dns",
            "ipv6",
            "direct_window"
          ]
        },
        "startedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "finishedAtEpoch": {
          "$ref": "#/$defs/positiveInteger"
        },
        "actionMarkerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcomeMarkerSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
