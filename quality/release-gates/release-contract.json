{
  "schemaVersion": 1,
  "candidate": {
    "workflow": ".github/workflows/release-candidate.yml",
    "trigger": {
      "event": "workflow_dispatch",
      "inputs": {
        "release_tag": {
          "required": true,
          "type": "string"
        }
      }
    },
    "requiredRef": "refs/heads/main",
    "requiredCi": {
      "workflow": ".github/workflows/ci.yml",
      "event": "push",
      "aggregateJob": "ci-required"
    }
  },
  "publication": {
    "workflow": ".github/workflows/release.yml",
    "trigger": {
      "event": "push",
      "tags": [
        "v*"
      ]
    },
    "candidateRunVariable": "RIPDPI_RELEASE_CANDIDATE_RUN_ID"
  },
  "releaseWindow": {
    "startShaVariable": "RIPDPI_RELEASE_WINDOW_START_SHA",
    "startedAtVariable": "RIPDPI_RELEASE_WINDOW_STARTED_AT",
    "recordDirectory": "quality/release-gates/release-windows",
    "maxAgeHours": 72,
    "maxCommits": 20,
    "maxCandidateRuns": 5,
    "allowedSubjectPatterns": [
      "^(fix|test|docs|ci|build)(\\([^)]+\\))?!?: .+$",
      "^chore\\(release\\)!?: .+$"
    ]
  },
  "localPreflight": {
    "runner": "scripts/ci/release_preflight.py",
    "recipe": "release-preflight",
    "reportVersion": "ripdpi_release_preflight_v1",
    "limitations": [
      "does-not-sign-artifacts",
      "does-not-replace-exact-sha-hosted-ci",
      "host-abi-only"
    ]
  },
  "assuranceProfiles": {
    "artifact-publish": {
      "releaseBlocking": true,
      "description": "Exact-SHA CI, signed immutable candidate, manifest, signatures, native ELF verification, attestations, and tag-bound publication."
    },
    "device-qualified": {
      "releaseBlocking": false,
      "description": "Artifact-publish plus separately recorded emulator, physical-device, or owner-lab evidence."
    },
    "owner-accepted": {
      "releaseBlocking": false,
      "description": "An explicit owner decision accepting named evidence gaps; it never fabricates or relabels test results."
    }
  },
  "guidance": [
    ".agents/skills/ripdpi-release/SKILL.md",
    ".agents/skills/release-signing/SKILL.md",
    ".agents/skills/release-changelog/SKILL.md",
    "docs/distribution.md",
    "docs/testing.md"
  ]
}
