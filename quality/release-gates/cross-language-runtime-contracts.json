{
  "version": "cross_language_runtime_contracts_v1",
  "description": "Machine-readable compatibility gate inventory for cross-language RIPDPI runtime contracts. Any Rust/Kotlin schema, diagnostics JSON, AppSettings protobuf, native config JSON, telemetry JSON, or JNI behavior field/default change must keep the listed sources, fixtures, invariants, and tests in sync. This artifact is enforced by scripts/ci/check_cross_language_runtime_contracts.py.",
  "ledgerKey": "cross-language-runtime-contract-gates",
  "surfaces": [
    {
      "id": "diagnostics-json-wire",
      "area": "diagnostics",
      "description": "Rust diagnostics wire structs and Kotlin EngineContract JSON models must decode the same shared request, progress, report, profile, and outcome fixtures.",
      "changeTriggers": [
        "Rust diagnostics wire field or serde default changes",
        "Kotlin EngineContract field or kotlinx.serialization default changes",
        "Diagnostics schemaVersion, outcome token, or profile catalog fixture changes"
      ],
      "sourcePaths": [
        "native/rust/crates/ripdpi-diagnostics-contracts/src/types/strategy.rs",
        "native/rust/crates/ripdpi-diagnostics-contracts/src/wire.rs",
        "native/rust/crates/ripdpi-diagnostics-contracts/src/wire/tests.rs",
        "native/rust/crates/ripdpi-monitor-engine/tests/contract_fixtures.rs",
        "core/diagnostics/src/main/kotlin/com/poyka/ripdpi/diagnostics/contract/engine/EngineContract.kt",
        "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsEngineSchemaValidationTest.kt",
        "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsWireContractTest.kt",
        "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsContractGovernanceTest.kt"
      ],
      "fixturePaths": [
        "diagnostics-contract-fixtures/engine_request_current.json",
        "diagnostics-contract-fixtures/engine_report_current.json",
        "diagnostics-contract-fixtures/engine_progress_current.json",
        "diagnostics-contract-fixtures/profile_catalog_current.json",
        "diagnostics-contract-fixtures/profile_spec_current.json",
        "diagnostics-contract-fixtures/outcome_taxonomy_current.json",
        "contract-fixtures/diagnostics_schema_version.json",
        "contract-fixtures/diagnostics_progress_fields.json",
        "contract-fixtures/diagnostics_scan_report_fields.json"
      ],
      "gateTests": [
        {
          "id": "rust-diagnostics-contract-fixtures",
          "path": "native/rust/crates/ripdpi-monitor-engine/tests/contract_fixtures.rs",
          "command": "cargo test --locked --manifest-path native/rust/Cargo.toml -p ripdpi-monitor-engine --test contract_fixtures"
        },
        {
          "id": "rust-diagnostics-schema-contract",
          "path": "native/rust/crates/ripdpi-diagnostics-contracts/src/wire/tests.rs",
          "command": "cargo test --locked --manifest-path native/rust/Cargo.toml -p ripdpi-diagnostics-contracts --lib"
        },
        {
          "id": "kotlin-diagnostics-wire-contract",
          "path": "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsWireContractTest.kt",
          "command": "./gradlew :core:diagnostics:testDebugUnitTest --tests 'com.poyka.ripdpi.diagnostics.DiagnosticsWireContractTest' -Pripdpi.skipNativeBuild=true"
        },
        {
          "id": "kotlin-diagnostics-governance-contract",
          "path": "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsContractGovernanceTest.kt",
          "command": "./gradlew :core:diagnostics:testDebugUnitTest --tests 'com.poyka.ripdpi.diagnostics.DiagnosticsContractGovernanceTest' -Pripdpi.skipNativeBuild=true"
        },
        {
          "id": "kotlin-diagnostics-schema-contract",
          "path": "core/diagnostics/src/test/kotlin/com/poyka/ripdpi/diagnostics/DiagnosticsEngineSchemaValidationTest.kt",
          "command": "./gradlew :core:diagnostics:testDebugUnitTest --tests 'com.poyka.ripdpi.diagnostics.DiagnosticsEngineSchemaValidationTest' -Pripdpi.skipNativeBuild=true"
        }
      ],
      "invariants": [
        "DiagnosticsEngineSchemaVersion equals DIAGNOSTICS_ENGINE_SCHEMA_VERSION.",
        "Kotlin and Rust both decode the same shared diagnostics contract fixtures.",
        "Field manifests cover progress and report fields when new diagnostics JSON fields or defaults are added.",
        "Native emitted outcome tokens are covered by the committed outcome taxonomy."
      ]
    },
    {
