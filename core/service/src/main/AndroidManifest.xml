<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Bound-only key observation: no TUN, FGS, or advertised VPN component. -->
        <service android:name="com.poyka.ripdpi.services.SshHostKeyProbeService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false" />
        <service android:name="com.poyka.ripdpi.services.RipDpiVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
        <service android:name="com.poyka.ripdpi.services.RipDpiProxyService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            tools:ignore="Instantiatable">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
        </service>

        <!--
            Boot-autostart receiver. Disabled by default (android:enabled="false");
            BootReceiver.setEnabled() toggles it on only while the user's "Start on
            boot" preference is enabled. BOOT_COMPLETED is delivered after credential
            storage becomes available; the receiver starts the FGS while the protected
            system broadcast is still active, so exported="true" is safe.
        -->
        <receiver
            android:name="com.poyka.ripdpi.services.BootReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
