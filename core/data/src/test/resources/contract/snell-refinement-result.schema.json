{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ripdpi-vpn-deploy/snell-refinement-result.schema.json",
  "type": "object",
  "required": ["schema_version", "observed_at", "vantage", "verdict", "config_sha256", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "observed_at": {"type": "integer", "minimum": 1},
    "vantage": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "verdict": {"enum": ["ok", "throttled", "blocked", "unknown", "error"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["profile", "verdict", "first_failure_bytes", "sizes"],
      "properties": {
        "profile": {"type": "string", "pattern": "^p3-snell-[a-z0-9-]+$"},
        "verdict": {"enum": ["ok", "throttled", "blocked", "unknown", "error"]},
        "first_failure_bytes": {"type": ["integer", "null"], "minimum": 1},
        "sizes": {"type": "array", "items": {"type": "object", "required": ["bytes", "control_healthy", "completed", "attempts", "median_ms", "control_median_ms"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "control_healthy": {"type": "boolean"}, "completed": {"type": "integer", "minimum": 0}, "attempts": {"type": "integer", "minimum": 1}, "median_ms": {"type": ["integer", "null"], "minimum": 0}, "control_median_ms": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    }
  }
}
