{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vpnd:network-exposure-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingress",
    "host_egress",
    "forwarded"
  ],
  "properties": {
    "ingress": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "host_egress": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "forwarded": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
