{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ripdpi.example/contract/observability-evidence.schema.json",
  "title": "RIPDPI observability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "manifest_generation",
    "manifest_source_id",
    "inventory_generation",
    "inventory_source_id",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"$ref": "#/$defs/alias"},
    "manifest_generation": {"$ref": "#/$defs/alias"},
    "manifest_source_id": {"$ref": "#/$defs/alias"},
    "inventory_generation": {"$ref": "#/$defs/alias"},
    "inventory_source_id": {"$ref": "#/$defs/alias"},
    "targets": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "deliveryReceipt": {
      "description": "Proof that one alert reached Telegram through Alertmanager and the relay. It names the alert, the UTC time and the Telegram message id only; additionalProperties false keeps the bot token and chat id out.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "environment", "receiver", "alert_name", "sent_at", "telegram_message_id"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "telegram-delivery-receipt"},
        "environment": {"const": "staging"},
        "receiver": {"const": "telegram-primary"},
        "alert_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,127}$"},
        "sent_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "telegram_message_id": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "metricName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
    },
    "labelValue": {"type": "string", "minLength": 1, "maxLength": 64},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "labels", "value"],
      "properties": {
        "family": {"$ref": "#/$defs/metricName"},
        "labels": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {"$ref": "#/$defs/alias"},
          "additionalProperties": {"$ref": "#/$defs/labelValue"}
        },
        "value": {"type": "number"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "observed_at", "samples"],
      "properties": {
        "target": {"$ref": "#/$defs/alias"},
        "status": {"enum": ["valid", "malformed"]},
        "observed_at": {"type": "integer", "minimum": 0},
        "samples": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/sample"}
        }
      }
    }
  }
}
