{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ripdpi.example/contract/observability-metric-manifest.schema.json",
  "title": "RIPDPI observability metric manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "source_id", "families"],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"$ref": "#/$defs/alias"},
    "source_id": {"$ref": "#/$defs/alias"},
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "metricName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "type",
        "unit",
        "labels",
        "max_series",
        "cadence_seconds",
        "stale_after_seconds",
        "alert_use"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/metricName"},
        "owner": {"$ref": "#/$defs/alias"},
        "type": {"enum": ["gauge", "counter"]},
        "unit": {
          "type": ["string", "null"],
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "labels": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["node", "role", "profile", "policy", "severity", "vantage"]
          }
        },
        "max_series": {"type": "integer", "minimum": 1, "maximum": 1024},
        "cadence_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "stale_after_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "alert_use": {"type": "boolean"}
      }
    }
  }
}
