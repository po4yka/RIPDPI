root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
# Compose @Composable functions use PascalCase by convention
ktlint_standard_function-naming = disabled
# Companion object vals in Android often use camelCase (e.g. intent extras, animation specs)
ktlint_standard_property-naming = disabled
# Opt-in since ktlint 1.7.0 (@Rule.OnlyWhenEnabledInEditorconfig). Without this line ktlintCheck runs
# in CI and passes while unused imports accumulate -- 521 of them had, across 94 files.
ktlint_standard_no-unused-imports = enabled

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4
